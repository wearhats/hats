---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Tile from '../components/Tile.astro';
import { TILES, type TileName } from '../assets/brand/tiles';
import './brand.css';

const TOKENS = ['bg', 'surface', 'surface-2', 'line', 'line-strong', 'ink', 'muted', 'accent', 'term-bg', 'term-ink', 'term-line', 'term-light', 'term-selected', 'term-dim', 'term-muted', 'term-control', 'warn'];
const TILE_NAMES = Object.keys(TILES) as TileName[];
---

<Base path="/brand" title="Brand sheet" noindex>
  <main id="main" class="wrap brand-sheet">
    <h1>Brand sheet</h1>
    <p class="lede">Development only. This page is never built.</p>
    <h2>Mark and wordmark</h2>
    <p class="brand-row">
      <Logo />
      <img src="/favicon.svg" width="16" height="16" alt="" />
      <img src="/favicon.svg" width="32" height="32" alt="" />
      <img src="/favicon.svg" width="96" height="96" alt="" />
      <img src="/favicon-32.png" width="32" height="32" alt="" />
    </p>
    <h2>Launcher tiles</h2>
    <p class="brand-row">{TILE_NAMES.map((name) => <Tile name={name} class="tile-large" />)}</p>
    <p class="brand-row">{TILE_NAMES.map((name) => <Tile name={name} class="tile-tiny" />)}</p>
    <h2>Tokens</h2>
    <ul class="swatches">
      {
        TOKENS.map((token) => (
          <li>
            <span class:list={['swatch', `swatch-${token}`]} />
            <code>--{token}</code>
          </li>
        ))
      }
    </ul>
    <h2>Type</h2>
    <p class="h1-sample">Wear every hat at once.</p>
    <p>Body text in the system stack. Short sentences, facts over adjectives.</p>
    <p><code>hats ps --profile work</code></p>
    <h2>Social cards</h2>
    <p><img class="brand-card" src="/og/home.png" width="1200" height="630" alt="Open Graph card" /></p>
  </main>
</Base>
