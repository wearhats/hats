---
import Tile from './Tile.astro';

const LAUNCHERS = [
  { tile: 'work', view: 'work', label: 'work' },
  { tile: 'personal', view: 'personal', label: 'personal' },
  { tile: 'acme', view: 'acme', label: 'acme' },
] as const;
---

<div class="dock" role="group" aria-label="Filter the sample output by profile">
  <div class="dock-group">
    <button type="button" class="dock-tile" data-filter="default" aria-pressed="false" disabled aria-label="Show profile default">
      <Tile name="claude-app" />
    </button>
    <span class="dock-label">your Claude.app, untouched</span>
  </div>
  <span class="dock-divider" aria-hidden="true"></span>
  <div class="dock-group">
    <div class="dock-tiles">
      {
        LAUNCHERS.map(({ tile, view, label }) => (
          <button type="button" class="dock-tile" data-filter={view} aria-pressed="false" disabled aria-label={`Show profile ${label}`}>
            <Tile name={tile} />
          </button>
        ))
      }
    </div>
    <span class="dock-label">hats launchers</span>
  </div>
</div>
