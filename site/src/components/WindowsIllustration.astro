---
import Tile from './Tile.astro';

const WINDOWS = [
  { tile: 'work', label: 'Work', accent: 'work' },
  { tile: 'personal', label: 'Personal', accent: 'personal' },
] as const;
---

<div class="windows" role="img" aria-label="Illustration: two separate windows open side by side, one labelled Work and one labelled Personal.">
  {
    WINDOWS.map(({ tile, label, accent }) => (
      <div class:list={['window', `window-${accent}`]}>
        <div class="window-bar">
          <Tile name={tile} />
          <span class="window-label">{label}</span>
        </div>
        <div class="window-body">
          <span class="bar bar-long" />
          <span class="bar bar-mid" />
          <span class="bar bar-short" />
        </div>
      </div>
    ))
  }
</div>
