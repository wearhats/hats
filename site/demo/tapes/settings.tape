# NOT RUN YET. Shared settings: Source this from each tape.
Set Shell "zsh"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1200
Set Height 640
Set Padding 24
Set Theme { "background": "#0F1115", "foreground": "#E6E8EB", "cursor": "#E6E8EB", "black": "#0F1115", "white": "#E6E8EB" }
Set TypingSpeed 45ms
