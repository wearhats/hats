{
  "name": "hats-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 8788",
    "test": "pnpm run test:built && pnpm run test:browser",
    "test:built": "node --test tests/built.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser.test.mjs",
    "lighthouse": "node tests/lighthouse.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "lighthouse": "13.6.0",
    "playwright": "1.64.1",
    "wrangler": "4.156.0"
  }
}
