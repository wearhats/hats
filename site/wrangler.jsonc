{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wearhats-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // The apex is the canonical origin. www is a zone redirect rule, so it has no
  // route here, and /install.sh is a zone redirect that runs before the Worker.
  "routes": [{ "pattern": "wearhats.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
